{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash -c 'exec python3 \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/userpromptsubmit-dispatch.py\"'", "timeout": 45 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "bash -c 'exec bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/posttooluse-deterministic-block.sh\"'", "timeout": 25 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash -c 'exec bash \"${PLUGIN_ROOT:-$CLAUDE_PLUGIN_ROOT}/hooks/sessionstart-init.sh\"'", "timeout": 20 }
        ]
      }
    ]
  }
}
